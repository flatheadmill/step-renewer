#!/usr/bin/env zshctl

source ${0:a:h}/config.zsh
source ${0:a:h}/step-renewer.zsh

function :args {
    eval "$(args -b ,config -- "$@")"
}

function :execute {
    if (( o_config )); then
        config
        return
    fi
    if [[ $STEP_RENEWER_UNSAFE_LOGGING = 1 ]]; then
        cat $BINDING_CONTEXT_PATH
        printf '\n'
    fi
    process_binding_context
}

# vim: ft=zsh :
